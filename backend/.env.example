# Copy this file to .env and fill in real values. NEVER commit .env.
PORT=5000

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Replace <db_password>.
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>.mongodb.net/clinicdb?retryWrites=true&w=majority&appName=Cluster0

# Long random strings — generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string

# Default admin (created automatically on first start if it doesn't exist)
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@clinic.com
ADMIN_PASSWORD=ChangeMe@123

# Optional: Cloudinary for uploaded photos/records. Strongly recommended when hosting,
# because Render's free disk is wiped on every deploy/restart.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: comma-separated web origins allowed by CORS (default * allows all)
# CORS_ORIGIN=https://your-web-app.com
